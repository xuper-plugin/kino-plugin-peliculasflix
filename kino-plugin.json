  "theme": {
    "accent": "#E50914",
    "onAccent": "#FFFFFF",
    "background": "#0C0708",
    "surface": "#1B1214",
    "highlight": "#F7C6C9"
  },
  "settings": [
    {
      "key": "lang",
      "type": "select",
      "label": "Idioma preferido",
      "labelEn": "Preferred language",
      "default": "latino",
      "options": [
        {
          "value": "latino",
          "label": "Latino",
          "labelEn": "Latin Spanish"
        },
        {
          "value": "castellano",
          "label": "Castellano",
          "labelEn": "Spain Spanish"
        },
        {
          "value": "subtitulado",
          "label": "Subtitulado",
          "labelEn": "Subtitled"
        }
      ],
      "hint": "Se prueba primero al reproducir; los otros quedan como copias.",
      "hintEn": "Tried first when you play; the others stay as copies."
    }
  ],
  "screen": {
    "label": "PeliculasFlix",
    "labelEn": "PeliculasFlix",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
